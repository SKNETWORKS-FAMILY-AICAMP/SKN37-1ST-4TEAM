%% holiday_db ERD  (MySQL, utf8mb4)
%% 생성 근거: db/holiday_db.sql 의 실제 DDL  ·  테이블 5개 + 뷰 3개
erDiagram
    accident_daily {
        INT id PK "AUTO_INCREMENT"
        SMALLINT year "연도"
        ENUM holiday "설날 | 추석"
        DATE acc_date "날짜"
        CHAR weekday "요일"
        ENUM level "전국 | 시도 | 시군구"
        VARCHAR sido "시도 (전국행=전국)"
        VARCHAR sigungu "시군구 (시도행=소계)"
        INT accidents "사고 건수"
        INT deaths "사망자"
        INT serious "중상자"
        INT injuries "부상자(중상 포함)"
    }
    holiday_dates {
        SMALLINT year PK "연도"
        ENUM holiday PK "설날 | 추석"
        DATE d_day "명절 당일 (음력 1/1, 8/15)"
    }
    hotspot {
        INT id PK "AUTO_INCREMENT"
        VARCHAR name "지점명"
        VARCHAR sido "시도"
        VARCHAR sigungu "시군구(원본)"
        VARCHAR sigungu_base "시군구(사고통계 정합명)"
        INT accidents "사고 건수"
        INT casualties "사상자"
        INT deaths "사망"
        INT serious "중상"
        INT minor "경상"
        INT reported "부상신고"
        DECIMAL lon "경도"
        DECIMAL lat "위도"
    }
    sido_boundary {
        VARCHAR sido PK "시도"
        JSON geojson "GeoJSON Feature"
    }
    faq {
        INT id PK "AUTO_INCREMENT"
        VARCHAR category "항목"
        VARCHAR question "질문"
        VARCHAR answer "답변"
        VARCHAR source "출처(보험사)"
    }

    holiday_dates ||--o{ accident_daily : "year + holiday 로 D-day 산출 (v_daily_d)"
    accident_daily ||..o{ hotspot : "sido + 시군구 논리 조인 (물리 FK 없음)"
    accident_daily ||..o{ sido_boundary : "sido 논리 조인 (물리 FK 없음)"
